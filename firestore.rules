rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function owner() { return signed() && request.auth.uid == 'lxZFcIJuSaPAzN6dgx7hSLo5PW22'; }
  function rootPath(uid) { return /databases/$(database)/documents/users/$(uid); }
  function companyPath(cid) { return /databases/$(database)/documents/companies/$(cid); }
  function membershipPath(cid,uid) { return /databases/$(database)/documents/companies/$(cid)/users/$(uid); }
  function rootCompany(cid) { return signed() && exists(rootPath(request.auth.uid)) && get(rootPath(request.auth.uid)).data.companyId == cid; }
  function active(cid) { return rootCompany(cid) && exists(companyPath(cid)) && get(companyPath(cid)).data.status == 'approved' && exists(membershipPath(cid,request.auth.uid)) && get(membershipPath(cid,request.auth.uid)).data.status == 'approved'; }
  function admin(cid) { return active(cid) && get(membershipPath(cid,request.auth.uid)).data.role in ['admin','superadmin']; }
  function superadmin(cid) { return active(cid) && get(membershipPath(cid,request.auth.uid)).data.role == 'superadmin'; }
  function founderBatch(cid) { return cid == request.auth.uid && getAfter(companyPath(cid)).data.founderUid == request.auth.uid && getAfter(companyPath(cid)).data.status == 'pending'; }
  function initialMembership(cid,uid) { return getAfter(membershipPath(cid,uid)).data.role == (uid == cid ? 'superadmin' : 'user') && getAfter(membershipPath(cid,uid)).data.status == 'pending'; }
  function validTeam(cid,tid) { return tid == '' || exists(/databases/$(database)/documents/companies/$(cid)/teams/$(tid)); }
  match /platform/settings {
   allow get: if owner(); allow list: if false;
   allow create,update: if owner() && request.resource.data.keys().hasOnly(['billingEnabled','updatedAt']) && request.resource.data.billingEnabled is bool;
   allow delete: if false;
  }
  match /users/{uid} {
   allow create: if signed() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['name','email','companyId','role','status','createdAt']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120 && request.resource.data.email == request.auth.token.email && request.resource.data.companyId is string && request.resource.data.companyId.size()>0 && request.resource.data.status == 'pending' && request.resource.data.role == (uid == request.resource.data.companyId ? 'superadmin' : 'user') && initialMembership(request.resource.data.companyId,uid) && (uid != request.resource.data.companyId || founderBatch(uid));
   allow get: if owner() || (signed() && request.auth.uid == uid);
   allow list,update,delete: if false;
  }
  match /companies/{cid} {
   allow create: if signed() && cid == request.auth.uid && request.resource.data.keys().hasOnly(['name','orgNumber','founderUid','status','plan','billingExempt','subscriptionStatus','trialDays','createdAt']) && request.resource.data.founderUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.plan == 'start' && request.resource.data.billingExempt == false && request.resource.data.subscriptionStatus == 'not_required' && request.resource.data.trialDays == 30 && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=150 && request.resource.data.orgNumber is string && request.resource.data.orgNumber.size()>0 && request.resource.data.orgNumber.size()<=30 && getAfter(rootPath(cid)).data.companyId == cid && initialMembership(cid,cid);
   allow get: if owner() || rootCompany(cid);
   allow list: if owner();
   allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','plan','billingExempt','subscriptionStatus']) && request.resource.data.status in ['pending','approved','rejected','paused'] && request.resource.data.plan in ['start','pro','enterprise'] && request.resource.data.billingExempt is bool && request.resource.data.subscriptionStatus in ['not_required','trial','active','past_due','canceled'] && (request.resource.data.status != 'approved' || resource.data.status != 'pending' || getAfter(membershipPath(cid,resource.data.founderUid)).data.status == 'approved');
   allow delete: if false;
   match /users/{uid} {
    allow create: if signed() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['name','email','role','status','teamId','createdAt']) && request.resource.data.email == request.auth.token.email && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120 && request.resource.data.status == 'pending' && request.resource.data.teamId == '' && request.resource.data.role == (uid == cid ? 'superadmin' : 'user') && getAfter(rootPath(uid)).data.companyId == cid && getAfter(rootPath(uid)).data.role == request.resource.data.role && (uid != cid || founderBatch(cid)) && getAfter(companyPath(cid)).data.status in ['pending','approved'];
    allow get: if owner() || (signed() && uid == request.auth.uid && rootCompany(cid)) || admin(cid);
    allow list: if admin(cid) || owner();
    allow update: if (owner() && uid == get(companyPath(cid)).data.founderUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['pending','approved'] && (request.resource.data.status != 'approved' || getAfter(companyPath(cid)).data.status == 'approved')) || (admin(cid) && uid != get(companyPath(cid)).data.founderUid && resource.data.role != 'superadmin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','role','teamId']) && request.resource.data.status in ['pending','approved','rejected','blocked'] && request.resource.data.role in ['user','admin'] && (request.resource.data.role == resource.data.role || superadmin(cid)) && request.resource.data.teamId is string && validTeam(cid,request.resource.data.teamId)) || (active(cid) && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId']) && request.resource.data.teamId is string && validTeam(cid,request.resource.data.teamId));
    allow delete: if false;
   }
   match /teams/{teamId} {
    allow get,list: if active(cid);
    allow create: if admin(cid) && request.resource.data.keys().hasOnly(['name','createdAt','createdBy']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80 && request.resource.data.createdBy == request.auth.uid;
    allow update,delete: if false;
   }
   match /jobs/{jobId} {
    allow get,list: if active(cid) && (admin(cid) || resource.data.ownerUid == request.auth.uid);
    allow create: if active(cid) && request.resource.data.ownerUid == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && validJob(request.resource.data,cid);
    allow update: if active(cid) && (admin(cid) || resource.data.ownerUid == request.auth.uid) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.ownerName == resource.data.ownerName && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedBy == request.auth.uid && validJob(request.resource.data,cid);
    allow delete: if active(cid) && (admin(cid) || resource.data.ownerUid == request.auth.uid);
   }
  }
  function validJob(d,cid) { return d.keys().hasAll(['ownerUid','ownerName','date','customer','littra','location','area','used','waste','notes','asphaltType','teamId','teamName','createdAt','updatedAt','updatedBy']) && d.keys().hasOnly(['ownerUid','ownerName','date','customer','littra','location','area','used','waste','notes','asphaltType','teamId','teamName','createdAt','updatedAt','updatedBy']) && d.ownerUid is string && d.ownerName is string && d.date is string && d.date.size()==10 && d.customer is string && d.customer.size()>0 && d.customer.size()<=150 && d.littra is string && d.littra.size()<=80 && d.location is string && d.location.size()<=200 && d.asphaltType is string && d.asphaltType.size()<=100 && d.teamId is string && d.teamName is string && d.teamName.size()<=80 && (d.teamId == '' ? d.teamName == '' : (exists(/databases/$(database)/documents/companies/$(cid)/teams/$(d.teamId)) && get(/databases/$(database)/documents/companies/$(cid)/teams/$(d.teamId)).data.name == d.teamName)) && d.notes is string && d.notes.size()<=3000 && d.area is number && d.area>=0 && d.area<=10000000 && d.used is number && d.used>=0 && d.used<=100000 && d.waste is number && d.waste>=0 && d.waste<=100000; }
 }
}
